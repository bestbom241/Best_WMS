# Postgres (ค่าตรงกับ DSN ที่ hardcode ไว้ในโค้ด Go ทั้ง 3 service — ห้ามแก้ค่าพวกนี้เฉยๆ
# ถ้าจะเปลี่ยน user/password/dbname ต้องไปแก้ dsn ใน main.go ของแต่ละ service ด้วย)
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=wms_gr
POSTGRES_PORT=5432

# Ports ที่ expose ออกมาที่เครื่อง host
AUTH_PORT=3002
INVENTORY_PORT=3001
GR_PORT=3000
MASTER_DATA_PORT=3003
OUTBOUND_PORT=3004
FRONTEND_PORT=80
